# AETHER Environment Configuration (Template)
# Copy this file to .env and adjust variables as needed.

# Application Environment
AETHER_ENV=development
LOG_LEVEL=INFO

# Backend API Service
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL Database Configuration (Port 5433 dedicated local cluster)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=aether_user
DB_PASSWORD=your_password_here
DB_NAME=aether_db
DATABASE_URL=postgresql+psycopg://aether_user:your_password_here@127.0.0.1:5433/aether_db

# Hardware-Conscious Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Local LLM Runtime (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
